<?php
declare(strict_types=1);

// Instalar como /home/rpvconst/conexion_rpv.php, fuera de public_html.
// Plantilla basada en el archivo recibido; reemplaza los valores antes de instalar.
$host = 'HOST_DE_BASE_DE_DATOS';
$dbname = 'NOMBRE_DE_BASE_DE_DATOS';
$username = 'USUARIO_DE_BASE_DE_DATOS';
$password = 'CONTRASENA_DE_CPANEL';

try {
    $pdo = new PDO(
        "mysql:host={$host};dbname={$dbname};charset=utf8mb4",
        $username,
        $password,
        [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            PDO::ATTR_EMULATE_PREPARES => false,
            PDO::ATTR_TIMEOUT => 5,
        ]
    );
} catch (Throwable $e) {
    error_log('RPV MYSQL ERROR: ' . $e->getMessage());
    throw $e;
}
