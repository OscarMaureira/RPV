DirectoryIndex index.php index.html

# Las copias de respaldo nunca deben quedar accesibles desde el webroot.
<IfModule mod_alias.c>
  RedirectMatch 404 "(?i)^/BKP(?:/|$)"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^BKP(?:/|$) - [R=404,L,NC]
  RewriteCond %{THE_REQUEST} \s/+((tinajas|calderas|estufas-a-pellets)/)index\.html(?:[?\s]) [NC]
  RewriteRule ^(tinajas|calderas|estufas-a-pellets)/index\.html$ /$1/ [R=302,L,NE]
</IfModule>
